rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pictures are shown through download links. Uploads: members who can edit, images only, up to 10 MB.
    // The preview function writes with admin rights and does not go through these rules.
    function role() { return firestore.get(/databases/(default)/documents/members/$(request.auth.token.email.lower())).data.role; }
    match /thumbs/{rest=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && role() in ['owner', 'editor']
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
