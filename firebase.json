{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs20" }],
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "*.rules", ".firebaserc", "README.md", ".git/**", ".gitignore", "functions/**", "seed/**", "**/node_modules/**", "**/.*"],
    "headers": [
      { "source": "sheets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }] },
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
